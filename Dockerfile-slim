# ===== STAGE 1: Build deps (CPU-only) =====
FROM python:3.11-slim AS builder

WORKDIR /app
COPY requirements.txt .

# Install deps into a temp dir, forcing CPU wheels for torch/torchvision
# - index-url (PyTorch CPU channel) first, then fallback to PyPI for the rest
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
      --target=/opt/python-deps \
      --index-url https://download.pytorch.org/whl/cpu \
      --extra-index-url https://pypi.org/simple \
      -r requirements.txt

# ===== STAGE 2: Runtime =====
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Copy only the built site-packages from builder
COPY --from=builder /opt/python-deps /usr/local/lib/python3.11/site-packages/

# Copy model + inference script
COPY model.pt inference.py ./

ENTRYPOINT ["python", "inference.py"]